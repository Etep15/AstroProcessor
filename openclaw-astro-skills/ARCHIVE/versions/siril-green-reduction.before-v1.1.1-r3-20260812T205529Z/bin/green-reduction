#!/usr/bin/env bash
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
ASTRO_PY="/home/peter/.openclaw/workspace/agents/codewarrior/AstroProcessor/.venv/bin/python"
ORCH="$ROOT/scripts/green_reduction_orchestrator.py"
LEGACY="$ROOT/bin/green-reduction-v1.0.3"

if [ "${1:-}" = "--version" ]; then
    printf '1.1.1\n'
    exit 0
fi

case "${1:-}" in
    advance|confirm-fresh|stage-status|review-publish|self-test)
        exec "$ASTRO_PY" "$ORCH" "$@"
        ;;
    *)
        exec "$LEGACY" "$@"
        ;;
esac
