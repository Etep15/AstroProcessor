#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PYTHON="${BLACK_POINT_PYTHON:-/home/peter/.openclaw/workspace/agents/codewarrior/AstroProcessor/.venv/bin/python}"
ORCH="$SCRIPT_DIR/../scripts/black_point_orchestrator.py"
LEGACY="${BLACK_POINT_LEGACY_WRAPPER:-$SCRIPT_DIR/black-point-v1.0.4}"

if [ "${1:-}" = "--version" ]; then
  printf '1.0.5\n'
  exit 0
fi

case "${1:-}" in
  advance|confirm-fresh|self-test)
    exec "$PYTHON" "$ORCH" "$@"
    ;;
  "")
    exec "$PYTHON" "$ORCH" --help
    ;;
  *)
    exec "$LEGACY" "$@"
    ;;
esac
